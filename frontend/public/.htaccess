# ---------------------------------------------------------------------------
# Déploiement du site sur hébergement mutualisé (cPanel / Apache).
#
# Ce fichier est copié tel quel dans dist/ au build, puis téléversé avec le
# reste du contenu à la racine web (public_html).
#
# Le site tient sur une page unique : toute URL inconnue est renvoyée vers
# index.html, qui affiche alors la page d'erreur de l'application.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force le HTTPS. À commenter tant que le certificat SSL n'est pas actif,
    # sinon le site devient inaccessible.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Retire le « www. » pour n'avoir qu'une seule URL canonique indexée.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # L'API PHP est servie à part : on ne touche pas à ses URL.
    RewriteRule ^api/ - [L]

    # Panel d'administration : une seule page pré-rendue (admin.html) pour
    # toutes ses adresses (/admin, /admin/medias, /admin/sections/hero…).
    RewriteRule ^admin(/.*)?$ admin.html [L]

    # Espace client : même principe (espace-client.html), y compris pour
    # les liens d'invitation reçus par email.
    RewriteRule ^espace-client(/.*)?$ espace-client.html [L]

    # Un fichier ou un dossier qui existe est servi directement.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Tout le reste retombe sur l'application React.
    RewriteRule ^ index.html [L]
</IfModule>

# --- Cache -----------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # Les fichiers de /assets portent un hachage dans leur nom : leur contenu
    # ne change jamais pour une URL donnée, on peut donc les garder un an.
    <FilesMatch "\.(js|css|woff2|woff|ttf|svg|jpg|jpeg|png|webp|avif|ico)$">
        ExpiresDefault "access plus 1 year"
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Le HTML, lui, doit être revalidé à chaque visite : sans cela un
    # déploiement resterait invisible pour les visiteurs déjà venus.
    <FilesMatch "\.html$">
        ExpiresDefault "access plus 0 seconds"
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>

# --- Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Sécurité --------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # HTTPS obligatoire pendant un an, même si l'on tape « http:// ». Va de
    # pair avec la redirection HTTPS en tête de fichier : à commenter avec
    # elle tant que le certificat SSL n'est pas actif.
    Header always set Strict-Transport-Security "max-age=31536000"

    # Politique de contenu des pages (pas des réponses de l'API, que ce
    # fichier couvre aussi quand elle est placée dans public_html/api : un
    # PDF ne s'afficherait plus). Les scripts intégrés aux pages sont admis
    # par leur empreinte, que scripts/csp.mjs écrit ici à chaque compilation
    # (les marqueurs __CSP_…__ ne doivent pas être retirés). Styles en ligne
    # admis : les pages pré-rendues portent des attributs style.
    <FilesMatch "\.html$">
        Header always set Content-Security-Policy "default-src 'self'; script-src 'self' __CSP_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'__CSP_API_ORIGIN__; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
    </FilesMatch>
</IfModule>

Options -Indexes

# ---------------------------------------------------------------------------
# Déploiement du site sur hébergement mutualisé (cPanel / Apache).
#
# Ce fichier est copié tel quel dans dist/ au build, puis téléversé avec le
# reste du contenu à la racine web (public_html).
#
# Le site tient sur une page unique : toute URL inconnue est renvoyée vers
# index.html, qui affiche alors la page d'erreur de l'application.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force le HTTPS. À commenter tant que le certificat SSL n'est pas actif,
    # sinon le site devient inaccessible.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Retire le « www. » pour n'avoir qu'une seule URL canonique indexée.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # L'API PHP est servie à part : on ne touche pas à ses URL.
    RewriteRule ^api/ - [L]

    # Un fichier ou un dossier qui existe est servi directement.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Tout le reste retombe sur l'application React.
    RewriteRule ^ index.html [L]
</IfModule>

# --- Cache -----------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # Les fichiers de /assets portent un hachage dans leur nom : leur contenu
    # ne change jamais pour une URL donnée, on peut donc les garder un an.
    <FilesMatch "\.(js|css|woff2|woff|ttf|svg|jpg|jpeg|png|webp|avif|ico)$">
        ExpiresDefault "access plus 1 year"
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Le HTML, lui, doit être revalidé à chaque visite : sans cela un
    # déploiement resterait invisible pour les visiteurs déjà venus.
    <FilesMatch "\.html$">
        ExpiresDefault "access plus 0 seconds"
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>

# --- Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Sécurité --------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

Options -Indexes

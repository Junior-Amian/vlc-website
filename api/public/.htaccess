# ---------------------------------------------------------------------------
# Point d'entrée public de l'API.
# Toutes les requêtes sont réécrites vers index.php (contrôleur frontal).
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Laisse passer les fichiers et dossiers qui existent réellement.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # L'en-tête Authorization est retiré par certains CGI/FastCGI :
    # on le réinjecte pour que l'espace client puisse s'authentifier.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
</IfModule>

# Masque la version de PHP dans les en-têtes de réponse. Limites d'envoi :
# documents de l'espace client jusqu'à 10 Mo (voir aussi .user.ini, lu à la
# place de ce bloc par PHP-FPM).
<IfModule mod_php.c>
    php_flag expose_php off
    php_value upload_max_filesize 12M
    php_value post_max_size 13M
</IfModule>

# Empêche le listage du répertoire.
Options -Indexes

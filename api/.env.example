# ---------------------------------------------------------------------------
# Copiez ce fichier en « .env » et renseignez les valeurs réelles.
# Le fichier .env ne doit JAMAIS être versionné ni déposé dans public_html.
# ---------------------------------------------------------------------------

APP_NAME="VISILION CORPORATE"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:5173

# --- Base de données --------------------------------------------------------
# En local (XAMPP) : root sans mot de passe.
# Sur cPanel : préfixe du compte, par exemple « visilion_visilion ».
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=visilion
DB_USERNAME=root
DB_PASSWORD=

# --- Origines autorisées (CORS) --------------------------------------------
# Séparées par des virgules, sans barre oblique finale.
# En production : https://visilioncorporate.com,https://www.visilioncorporate.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Emails -----------------------------------------------------------------
# « mail » en production (fonction mail() du mutualisé).
# « log » en local : les emails sont écrits dans storage/logs/mail-AAAA-MM-JJ.log.
MAIL_TRANSPORT=log
MAIL_FROM_ADDRESS=contact@visilioncorporate.com
MAIL_FROM_NAME="VISILION CORPORATE"
MAIL_ADMIN_ADDRESS=infovisilioncorporate@gmail.com
# Espace client : adresse de réponse des emails d'invitation et de mot de
# passe. PROVISOIRE, adresse fictive en attendant celle du client.
MAIL_DOSSIERS_ADDRESS=dossiers@visilioncorporate.com

# --- Sécurité ---------------------------------------------------------------
# Clé de signature des sessions du panel d'administration (et, plus tard, de
# l'espace client). OBLIGATOIRE : sans elle, la connexion au panel échoue.
# 32 caractères minimum, propre à chaque serveur, jamais partagée.
# Générer avec : php -r "echo bin2hex(random_bytes(32));"
# La changer déconnecte tous les administrateurs.
JWT_SECRET=
